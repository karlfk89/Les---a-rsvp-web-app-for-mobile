# Les – RSVP-leser. Static files only; the app has no backend.
#
# SITE_ADDRESS decides how HTTPS is handled (see docs/SELVHOSTING.md):
#   :80                  plain HTTP behind Tailscale Serve or another HTTPS proxy (default)
#   les.example.no       public domain, certificate from Let's Encrypt
#   https://192.168.1.50 local network, with TLS_DIRECTIVE="tls internal" (Caddy's own CA)
# TLS_DIRECTIVE is inserted as a line of its own; leave it unset otherwise.

{$SITE_ADDRESS::80} {
	{$TLS_DIRECTIVE}
	root * {$APP_ROOT:/srv}
	encode zstd gzip
	file_server

	@modules path *.mjs
	header @modules Content-Type "text/javascript; charset=utf-8"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# The service worker and start page are always revalidated so updates reach the phone.
	@fresh path / /index.html /sw.js
	header @fresh Cache-Control "no-cache"
}
